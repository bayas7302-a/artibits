{"id": 7424, "date": "2026-09-17T13:21:48", "date_gmt": "2026-09-17T13:21:48", "guid": {"rendered": "https://artibits.com/?p=7424", "raw": "https://artibits.com/?p=7424"}, "modified": "2026-09-17T13:26:47", "modified_gmt": "2026-09-17T13:26:47", "password": "", "slug": "ai-powered-comment-resolution-for-engineering-drawings-and-documents", "status": "publish", "type": "post", "link": "https://artibits.com/2026/09/17/ai-powered-comment-resolution-for-engineering-drawings-and-documents/", "title": {"raw": "AI-Powered Comment Resolution for Engineering Drawings and Documents", "rendered": "AI-Powered Comment Resolution for Engineering Drawings and Documents"}, "content": {"raw": "<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\",\"fontSize\":\"medium\"} -->\n<p class=\"has-black-color has-text-color has-link-color has-medium-font-size\"><strong>How Artisan Is Designed to Centralize, Route and Track Engineering Comments</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\">Artisan is proposed as an AI-agentic workflow for capturing comments from engineering drawings and documents, assigning them to the appropriate owners, and tracking every item through acknowledgement and resolution.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\"><strong>Pilot at a Glance</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\"><strong>30</strong> - Drawings and documents in the proposed pilot</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\"><strong>Approximately 1,500</strong> - Comments across multiple engineering disciplines</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\"><strong>Days to Hours</strong> - Target reduction in acknowledgement time</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\"></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\"><strong>Project Overview</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\"><strong>Industry:</strong> Engineering, Industrial and EPC</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\"><strong>Solution:</strong> Artisan - AI-Agentic Comment Resolution Workflow</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\"><strong>Status:</strong> Proposed Pilot</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\"><strong>Pilot Scope:</strong> 30 drawings and documents</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\"><strong>Estimated Volume:</strong> Approximately 1,500 comments</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\"></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\"><strong>The Challenge</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\">Engineering comments were distributed across drawings, models, specifications, datasheets, emails and multiple document revisions.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\"><strong>Key Challenges</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<ul class=\"wp-block-list has-black-color has-text-color has-link-color\"><!-- wp:list-item -->\n<li>Comments distributed across multiple documents and systems</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Manual comment identification and logging</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>No centralized register of ownership and status</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Risk of using outdated document revisions</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Time-consuming assignment and follow-up</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Delayed or unresolved comments</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Potential delays to engineering and procurement</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Increased expediting costs and commercial exposure</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Potential effects on revenue recognition and liquidated damages</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\"><strong>Before Artisan</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\"><strong>Documents and Emails \u2192 Manual Comment Extraction \u2192 Spreadsheet Register \u2192 Manual Assignment \u2192 Repeated Follow-Up</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\">This fragmented process limited visibility, weakened traceability and increased the risk of comments remaining unresolved.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\"><strong>The Proposed Solution</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\">Drishya AI proposed Artisan as an AI-agentic comment-management workflow.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\">The system is designed to monitor documents, extract and classify comments, assign them to the appropriate owners and provide centralized status visibility.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\"><strong>The Proposed Solution Includes</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<ul class=\"wp-block-list has-black-color has-text-color has-link-color\"><!-- wp:list-item -->\n<li>Monitoring documents from Wrench and email inboxes</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Automated comment extraction</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Classification by discipline, type and document creator</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Human review of low-confidence classifications</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>A single canonical comment register</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Links between comments, documents and revisions</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Automated routing to mapped owners</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Context-rich owner notifications</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Acknowledgement and status tracking</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Automated reminders, escalations and reassignment</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\"><br><strong>How Artisan Would Work</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\"><strong>Documents \u2192 Comment Extraction \u2192 Classification \u2192 Owner Assignment \u2192 Status Tracking \u2192 Resolution</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\">Artisan would monitor incoming documents, identify and classify comments, route them to the appropriate owners, and track each item through acknowledgement and resolution.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:html -->\n<style>\n.before-after-table {\n    width: 100%;\n    border-collapse: collapse;\n    font-family: 'Poppins', sans-serif;\n    margin: 20px 0;\n}\n\n.before-after-table th {\n    font-size: 20px;\n    font-weight: 600;\n    padding: 18px 20px;\n    text-align: left;\n    border: 1px solid #ddd;\n}\n\n.before-after-table td {\n    font-size: 15px;\n    font-weight: 400;\n    padding: 16px 20px;\n    text-align: left;\n    border: 1px solid #e5e5e5;\n    color: #333;\n}\n\n.before-after-table th:first-child,\n.before-after-table th:last-child {\n    width: 50%;\n}\n\n@media (max-width: 767px) {\n    .before-after-table th {\n        font-size: 18px;\n        padding: 14px 12px;\n    }\n\n    .before-after-table td {\n        font-size: 14px;\n        padding: 13px 12px;\n    }\n}\n</style>\n\n<table class=\"before-after-table\">\n    <thead>\n        <tr>\n            <th>Before</th>\n            <th>Proposed Workflow</th>\n        </tr>\n    </thead>\n\n    <tbody>\n        <tr>\n            <td>Manual extraction</td>\n            <td>AI-assisted extraction</td>\n        </tr>\n\n        <tr>\n            <td>Spreadsheet tracking</td>\n            <td>Canonical comment register</td>\n        </tr>\n\n        <tr>\n            <td>Manual classification</td>\n            <td>Automated classification with human review</td>\n        </tr>\n\n        <tr>\n            <td>Unclear ownership</td>\n            <td>Rules-based owner assignment</td>\n        </tr>\n\n        <tr>\n            <td>Repeated follow-up</td>\n            <td>Automated reminders and escalations</td>\n        </tr>\n\n        <tr>\n            <td>Limited revision traceability</td>\n            <td>Comments linked to documents and revisions</td>\n        </tr>\n\n        <tr>\n            <td>Delayed reporting</td>\n            <td>Live ownership and status visibility</td>\n        </tr>\n    </tbody>\n</table>\n<!-- /wp:html -->\n\n<!-- wp:paragraph -->\n<p></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\"><strong>Pilot Scope and Expected Outcomes</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\"><strong>30 Drawings and Documents</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\">The proposed pilot would evaluate Artisan across 30 engineering drawings and documents.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\"><strong>Approximately 1,500 Comments</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\">The pilot would include comments across piping, mechanical, electrical and instrumentation, structural, process and other engineering disciplines.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\"><strong>Acknowledgement Time: Days to Hours</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\">The intended outcome is to reduce comment-acknowledgement time from days to hours.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\"><strong>Additional Intended Outcomes</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<ul class=\"wp-block-list has-black-color has-text-color has-link-color\"><!-- wp:list-item -->\n<li>One canonical register for engineering comments</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Live visibility into ownership and status</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Traceability across documents and revisions</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Automated routing, reminders and escalations</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>End-to-end acknowledgement tracking</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Faster responses to comments affecting engineering and procurement</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Greater accountability across disciplines</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\",\"fontSize\":\"medium\"} -->\n<p class=\"has-black-color has-text-color has-link-color has-medium-font-size\"><br><strong>Important Status Note</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\"><strong>This initiative is a proposed pilot. The stated improvements are intended outcomes and have not yet been demonstrated or validated at scale.</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\"><br><strong>Key Takeaway</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph {\"style\":{\"elements\":{\"link\":{\"color\":{\"text\":\"var:preset|color|black\"}}}},\"textColor\":\"black\"} -->\n<p class=\"has-black-color has-text-color has-link-color\">Artisan is designed to transform engineering comment management from a manual review and follow-up process into a centralized, traceable AI-agentic workflow\u2014subject to validation through the proposed pilot.</p>\n<!-- /wp:paragraph -->", "rendered": "\n<p class=\"has-black-color has-text-color has-link-color has-medium-font-size wp-elements-82 wp-block-paragraph\"><strong>How Artisan Is Designed to Centralize, Route and Track Engineering Comments</strong></p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-83 wp-block-paragraph\">Artisan is proposed as an AI-agentic workflow for capturing comments from engineering drawings and documents, assigning them to the appropriate owners, and tracking every item through acknowledgement and resolution.</p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-84 wp-block-paragraph\"><strong>Pilot at a Glance</strong></p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-85 wp-block-paragraph\"><strong>30</strong> &#8211; Drawings and documents in the proposed pilot</p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-86 wp-block-paragraph\"><strong>Approximately 1,500</strong> &#8211; Comments across multiple engineering disciplines</p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-87 wp-block-paragraph\"><strong>Days to Hours</strong> &#8211; Target reduction in acknowledgement time</p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-88 wp-block-paragraph\"></p>\n\n\n\n<p class=\"wp-block-paragraph\"></p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-89 wp-block-paragraph\"><strong>Project Overview</strong></p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-90 wp-block-paragraph\"><strong>Industry:</strong> Engineering, Industrial and EPC</p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-91 wp-block-paragraph\"><strong>Solution:</strong> Artisan &#8211; AI-Agentic Comment Resolution Workflow</p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-92 wp-block-paragraph\"><strong>Status:</strong> Proposed Pilot</p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-93 wp-block-paragraph\"><strong>Pilot Scope:</strong> 30 drawings and documents</p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-94 wp-block-paragraph\"><strong>Estimated Volume:</strong> Approximately 1,500 comments</p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-95 wp-block-paragraph\"></p>\n\n\n\n<p class=\"wp-block-paragraph\"></p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-96 wp-block-paragraph\"><strong>The Challenge</strong></p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-97 wp-block-paragraph\">Engineering comments were distributed across drawings, models, specifications, datasheets, emails and multiple document revisions.</p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-98 wp-block-paragraph\"><strong>Key Challenges</strong></p>\n\n\n\n<ul class=\"wp-block-list has-black-color has-text-color has-link-color wp-elements-99\">\n<li>Comments distributed across multiple documents and systems</li>\n\n\n\n<li>Manual comment identification and logging</li>\n\n\n\n<li>No centralized register of ownership and status</li>\n\n\n\n<li>Risk of using outdated document revisions</li>\n\n\n\n<li>Time-consuming assignment and follow-up</li>\n\n\n\n<li>Delayed or unresolved comments</li>\n\n\n\n<li>Potential delays to engineering and procurement</li>\n\n\n\n<li>Increased expediting costs and commercial exposure</li>\n\n\n\n<li>Potential effects on revenue recognition and liquidated damages</li>\n</ul>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-100 wp-block-paragraph\"><strong>Before Artisan</strong></p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-101 wp-block-paragraph\"><strong>Documents and Emails \u2192 Manual Comment Extraction \u2192 Spreadsheet Register \u2192 Manual Assignment \u2192 Repeated Follow-Up</strong></p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-102 wp-block-paragraph\">This fragmented process limited visibility, weakened traceability and increased the risk of comments remaining unresolved.</p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-103 wp-block-paragraph\"><strong>The Proposed Solution</strong></p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-104 wp-block-paragraph\">Drishya AI proposed Artisan as an AI-agentic comment-management workflow.</p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-105 wp-block-paragraph\">The system is designed to monitor documents, extract and classify comments, assign them to the appropriate owners and provide centralized status visibility.</p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-106 wp-block-paragraph\"><strong>The Proposed Solution Includes</strong></p>\n\n\n\n<ul class=\"wp-block-list has-black-color has-text-color has-link-color wp-elements-107\">\n<li>Monitoring documents from Wrench and email inboxes</li>\n\n\n\n<li>Automated comment extraction</li>\n\n\n\n<li>Classification by discipline, type and document creator</li>\n\n\n\n<li>Human review of low-confidence classifications</li>\n\n\n\n<li>A single canonical comment register</li>\n\n\n\n<li>Links between comments, documents and revisions</li>\n\n\n\n<li>Automated routing to mapped owners</li>\n\n\n\n<li>Context-rich owner notifications</li>\n\n\n\n<li>Acknowledgement and status tracking</li>\n\n\n\n<li>Automated reminders, escalations and reassignment</li>\n</ul>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-108 wp-block-paragraph\"><br><strong>How Artisan Would Work</strong></p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-109 wp-block-paragraph\"><strong>Documents \u2192 Comment Extraction \u2192 Classification \u2192 Owner Assignment \u2192 Status Tracking \u2192 Resolution</strong></p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-110 wp-block-paragraph\">Artisan would monitor incoming documents, identify and classify comments, route them to the appropriate owners, and track each item through acknowledgement and resolution.</p>\n\n\n\n<style>\n.before-after-table {\n    width: 100%;\n    border-collapse: collapse;\n    font-family: 'Poppins', sans-serif;\n    margin: 20px 0;\n}\n\n.before-after-table th {\n    font-size: 20px;\n    font-weight: 600;\n    padding: 18px 20px;\n    text-align: left;\n    border: 1px solid #ddd;\n}\n\n.before-after-table td {\n    font-size: 15px;\n    font-weight: 400;\n    padding: 16px 20px;\n    text-align: left;\n    border: 1px solid #e5e5e5;\n    color: #333;\n}\n\n.before-after-table th:first-child,\n.before-after-table th:last-child {\n    width: 50%;\n}\n\n@media (max-width: 767px) {\n    .before-after-table th {\n        font-size: 18px;\n        padding: 14px 12px;\n    }\n\n    .before-after-table td {\n        font-size: 14px;\n        padding: 13px 12px;\n    }\n}\n</style>\n\n<table class=\"before-after-table\">\n    <thead>\n        <tr>\n            <th>Before</th>\n            <th>Proposed Workflow</th>\n        </tr>\n    </thead>\n\n    <tbody>\n        <tr>\n            <td>Manual extraction</td>\n            <td>AI-assisted extraction</td>\n        </tr>\n\n        <tr>\n            <td>Spreadsheet tracking</td>\n            <td>Canonical comment register</td>\n        </tr>\n\n        <tr>\n            <td>Manual classification</td>\n            <td>Automated classification with human review</td>\n        </tr>\n\n        <tr>\n            <td>Unclear ownership</td>\n            <td>Rules-based owner assignment</td>\n        </tr>\n\n        <tr>\n            <td>Repeated follow-up</td>\n            <td>Automated reminders and escalations</td>\n        </tr>\n\n        <tr>\n            <td>Limited revision traceability</td>\n            <td>Comments linked to documents and revisions</td>\n        </tr>\n\n        <tr>\n            <td>Delayed reporting</td>\n            <td>Live ownership and status visibility</td>\n        </tr>\n    </tbody>\n</table>\n\n\n\n<p class=\"wp-block-paragraph\"></p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-111 wp-block-paragraph\"><strong>Pilot Scope and Expected Outcomes</strong></p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-112 wp-block-paragraph\"><strong>30 Drawings and Documents</strong></p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-113 wp-block-paragraph\">The proposed pilot would evaluate Artisan across 30 engineering drawings and documents.</p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-114 wp-block-paragraph\"><strong>Approximately 1,500 Comments</strong></p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-115 wp-block-paragraph\">The pilot would include comments across piping, mechanical, electrical and instrumentation, structural, process and other engineering disciplines.</p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-116 wp-block-paragraph\"><strong>Acknowledgement Time: Days to Hours</strong></p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-117 wp-block-paragraph\">The intended outcome is to reduce comment-acknowledgement time from days to hours.</p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-118 wp-block-paragraph\"><strong>Additional Intended Outcomes</strong></p>\n\n\n\n<ul class=\"wp-block-list has-black-color has-text-color has-link-color wp-elements-119\">\n<li>One canonical register for engineering comments</li>\n\n\n\n<li>Live visibility into ownership and status</li>\n\n\n\n<li>Traceability across documents and revisions</li>\n\n\n\n<li>Automated routing, reminders and escalations</li>\n\n\n\n<li>End-to-end acknowledgement tracking</li>\n\n\n\n<li>Faster responses to comments affecting engineering and procurement</li>\n\n\n\n<li>Greater accountability across disciplines</li>\n</ul>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color has-medium-font-size wp-elements-120 wp-block-paragraph\"><br><strong>Important Status Note</strong></p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-121 wp-block-paragraph\"><strong>This initiative is a proposed pilot. The stated improvements are intended outcomes and have not yet been demonstrated or validated at scale.</strong></p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-122 wp-block-paragraph\"><br><strong>Key Takeaway</strong></p>\n\n\n\n<p class=\"has-black-color has-text-color has-link-color wp-elements-123 wp-block-paragraph\">Artisan is designed to transform engineering comment management from a manual review and follow-up process into a centralized, traceable AI-agentic workflow\u2014subject to validation through the proposed pilot.</p>\n", "protected": false, "block_version": 1}, "excerpt": {"raw": "", "rendered": "<p>How Artisan Is Designed to Centralize, Route and Track Engineering Comments Artisan is proposed as an AI-agentic workflow for capturing comments from engineering drawings and documents, assigning them to the appropriate owners, and tracking every item through acknowledgement and resolution. Pilot at a Glance 30 &#8211; Drawings and documents in the proposed pilot Approximately 1,500 [&hellip;]</p>\n", "protected": false}, "author": 1, "featured_media": 7426, "comment_status": "open", "ping_status": "open", "sticky": false, "template": "", "format": "standard", "meta": {"footnotes": "", "_elementor_edit_mode": "", "_elementor_template_type": "wp-post", "_elementor_data": "", "_elementor_page_settings": null, "_elementor_conditions": []}, "categories": [122, 116], "tags": [], "permalink_template": "https://artibits.com/2026/09/17/%postname%/", "generated_slug": "ai-powered-comment-resolution-for-engineering-drawings-and-documents", "class_list": ["post-7424", "post", "type-post", "status-publish", "format-standard", "has-post-thumbnail", "hentry", "category-epc", "category-industrial"], "_links": {"self": [{"href": "https://artibits.com/wp-json/wp/v2/posts/7424", "targetHints": {"allow": ["GET", "POST", "PUT", "PATCH", "DELETE"]}}], "collection": [{"href": "https://artibits.com/wp-json/wp/v2/posts"}], "about": [{"href": "https://artibits.com/wp-json/wp/v2/types/post"}], "author": [{"embeddable": true, "href": "https://artibits.com/wp-json/wp/v2/users/1"}], "replies": [{"embeddable": true, "href": "https://artibits.com/wp-json/wp/v2/comments?post=7424"}], "version-history": [{"count": 4, "href": "https://artibits.com/wp-json/wp/v2/posts/7424/revisions"}], "predecessor-version": [{"id": 7431, "href": "https://artibits.com/wp-json/wp/v2/posts/7424/revisions/7431"}], "wp:featuredmedia": [{"embeddable": true, "href": "https://artibits.com/wp-json/wp/v2/media/7426"}], "wp:attachment": [{"href": "https://artibits.com/wp-json/wp/v2/media?parent=7424"}], "wp:term": [{"taxonomy": "category", "embeddable": true, "href": "https://artibits.com/wp-json/wp/v2/categories?post=7424"}, {"taxonomy": "post_tag", "embeddable": true, "href": "https://artibits.com/wp-json/wp/v2/tags?post=7424"}], "wp:action-publish": [{"href": "https://artibits.com/wp-json/wp/v2/posts/7424"}], "wp:action-unfiltered-html": [{"href": "https://artibits.com/wp-json/wp/v2/posts/7424"}], "wp:action-sticky": [{"href": "https://artibits.com/wp-json/wp/v2/posts/7424"}], "wp:action-assign-author": [{"href": "https://artibits.com/wp-json/wp/v2/posts/7424"}], "wp:action-create-categories": [{"href": "https://artibit